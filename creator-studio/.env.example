# ───────────── Core ─────────────
# PostgreSQL in production. Leave unset to use the embedded PGlite database (./data/pglite).
# DATABASE_URL=postgres://user:pass@localhost:5432/creator_studio
# PGLITE_DIR=./data/pglite
# DB_AUTO_MIGRATE=true
# DATABASE_POOL_MAX=10

# REQUIRED in production: 32 random bytes, base64 (openssl rand -base64 32).
# Encrypts provider API keys and social tokens at rest. Changing it makes stored secrets unreadable.
# APP_ENCRYPTION_KEY=

# Public base URL (OAuth redirect URIs, signed media links for Instagram/Blotato).
# APP_PUBLIC_URL=https://studio.example.com

# Comma-separated emails that become platform admins on sign-up. If unset, the first account is admin.
# PLATFORM_ADMIN_EMAILS=you@example.com
# FIRST_USER_IS_ADMIN=true
# DEFAULT_PLAN_ID=free

# ───────────── Storage ─────────────
# STORAGE_DRIVER=local            # local | s3
# STORAGE_DIR=./storage/data
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=                    # e.g. https://<account>.r2.cloudflarestorage.com or http://minio:9000
# (S3 credentials come from the standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars.
#  Install the optional dependency first: npm i @aws-sdk/client-s3)
# MAX_UPLOAD_MB=500

# ───────────── Jobs & rendering ─────────────
# RUN_WORKER_IN_PROCESS=true      # set false on web nodes when running `npm run worker` separately (PostgreSQL only)
# WORKER_CONCURRENCY=2
# WORKER_POLL_MS=1000
# VIDEO_POLL_MS=5000
# VIDEO_TIMEOUT_MS=1800000
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# FONTS_DIR=./public/fonts

# ───────────── Platform-managed AI keys (optional) ─────────────
# Used only for organizations that enable "platform-managed keys"; billed against plan AI credits.
# PLATFORM_ANTHROPIC_API_KEY=
# PLATFORM_OPENAI_API_KEY=
# PLATFORM_GEMINI_API_KEY=
# PLATFORM_RUNWAY_API_KEY=
# PLATFORM_KLING_API_KEY=
# PLATFORM_SEEDANCE_API_KEY=
# PLATFORM_ELEVENLABS_API_KEY=

# ───────────── Publishing OAuth (optional) ─────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_APP_AUDITED=false        # true only after TikTok approves your Content Posting API audit
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_VERSION=v24.0
# PUBLISH_POLL_MS=5000

# ───────────── Security / ops ─────────────
# API_RATE_LIMIT_PER_MIN=600
# INSECURE_COOKIES=false          # only for local HTTP testing of a production build
